---
import Base from '../../layouts/Base.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { Image, PortableText } from 'emdash/ui';
import { entry,globalContent,money,fileUrl,safeLink } from '../../lib/cms';
const [p,g]=await Promise.all([entry('properties',Astro.params.slug!,{agent:true,branch:true,area:true}),globalContent()]);
if(!p)return Astro.rewrite('/404');
const d=p.data, agent=p.references?.agent?.entries[0],branch=p.references?.branch?.entries[0],area=p.references?.area?.entries[0];
const gallery=d.gallery?.length?d.gallery:[{image:d.image,caption:d.title}];
---
<Base title={d.title} description={d.excerpt} global={g} content={{collection:'properties',id:d.id,slug:p.id}}>
<div class="container property-top"><a class="text-link" href={d.market==='sale'?'/sales':'/lettings'}>← {g.ui.back_search}</a><span>{d.reference} · {g.ui.fictional}</span></div>
<section class="container property-gallery">{gallery.map((item:any,i:number)=><button class:list={['gallery-thumb',{'gallery-main':i===0}]} data-gallery-index={i} aria-label={`${g.ui.image_open}: ${item.caption}`}><Image image={item.image} priority={i===0}/>{i===0&&<span class="badge">{d.availability}</span>}</button>)}</section>
<dialog class="gallery-dialog"><button data-gallery-close class="dialog-close" aria-label={g.ui.close}>×</button><div class="gallery-slides">{gallery.map((item:any,i:number)=><figure data-slide={i} hidden={i!==0}><Image image={item.image}/><figcaption>{item.caption}</figcaption></figure>)}</div><div class="gallery-controls"><button data-gallery-prev>{g.ui.image_previous}</button><button data-gallery-next>{g.ui.image_next}</button></div></dialog>
<div class="container property-layout"><article><p class="eyebrow">{d.location} · {d.property_type}</p><h1 {...p.edit.title}>{d.title}</h1><p class="address">{d.address}, {d.postcode}</p><p class="detail-price">{money(d.price)} <span>{d.qualifier}</span></p><div class="detail-specs"><span><strong>{d.bedrooms}</strong>{g.ui.beds}</span><span><strong>{d.bathrooms}</strong>{g.ui.baths}</span><span><strong>{d.floor_area}</strong>{g.ui.area_unit}</span></div><h2>{g.ui.key_features}</h2><ul class="features">{d.features?.map((f:any)=><li>{f.text}</li>)}</ul><h2>{g.ui.description}</h2><div class="prose" {...p.edit.description}><PortableText value={d.description}/></div><dl class="facts">{[['availability',d.availability],['tenure',d.tenure],['council_tax',d.council_tax],['epc_rating',d.epc_rating],...(d.market==='let'?[['deposit',money(d.deposit)]]:[])].map(([k,v])=><div><dt>{g.ui[k]}</dt><dd>{v}</dd></div>)}</dl>
<h2>{g.ui.floorplans}</h2><p class="muted">{g.ui.demo_documents}</p><div class="document-links">{fileUrl(d.floorplan)&&<a class="text-link" href={fileUrl(d.floorplan)} target="_blank" rel="noopener noreferrer">{g.ui.floorplan} ↗</a>}{d.floorplans?.map((f:any)=>safeLink(f.url)&&<a class="text-link" href={safeLink(f.url)} target="_blank" rel="noopener noreferrer">{f.title} ↗</a>)}{fileUrl(d.brochure)&&<a class="text-link" href={fileUrl(d.brochure)}>{g.ui.brochure} ↗</a>}{fileUrl(d.epc)&&<a class="text-link" href={fileUrl(d.epc)}>{g.ui.epc} ↗</a>}</div><div class="location-card"><p class="eyebrow">{d.location}</p><h3>{d.address}</h3><a class="text-link" href={`https://www.openstreetmap.org/?mlat=${d.latitude}&mlon=${d.longitude}#map=14/${d.latitude}/${d.longitude}`} target="_blank" rel="noopener noreferrer">{g.ui.map} ↗</a>{area&&<p><a href={`/areas/${area.id}`}>{area.data.title} ↗</a></p>}</div>{safeLink(d.video_link)&&<a class="text-link" href={safeLink(d.video_link)} target="_blank" rel="noopener noreferrer">{g.ui.video} ↗</a>}</article>
<aside><div class="agent-panel">{agent&&<><p class="eyebrow">{g.ui.agent}</p><div class="agent-identity"><span class="avatar">{agent.data.initials}</span><div><h3>{agent.data.title}</h3><p>{agent.data.role}</p></div></div></>}{branch&&<p><a href={`/branches/${branch.id}`}>{branch.data.title} ↗</a><br/>{branch.data.phone}</p>}<hr/><h2>{g.ui.viewing}</h2><p>{g.ui.viewing_text}</p><EnquiryForm global={g} kind="viewing" property={d.id}/></div></aside></div></Base>
<script>
const dialog=document.querySelector<HTMLDialogElement>('.gallery-dialog');let active=0;let opener:HTMLElement|null=null;const slides=Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));const show=(n:number)=>{active=(n+slides.length)%slides.length;slides.forEach((s,i)=>s.hidden=i!==active);};document.querySelectorAll<HTMLElement>('[data-gallery-index]').forEach(button=>button.addEventListener('click',()=>{opener=button;show(Number(button.dataset.galleryIndex));dialog?.showModal();}));document.querySelector('[data-gallery-close]')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('close',()=>opener?.focus());document.querySelector('[data-gallery-prev]')?.addEventListener('click',()=>show(active-1));document.querySelector('[data-gallery-next]')?.addEventListener('click',()=>show(active+1));dialog?.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')show(active-1);if(e.key==='ArrowRight')show(active+1);});
</script>
