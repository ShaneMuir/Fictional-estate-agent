---
import Base from '../layouts/Base.astro';
import { entries,entry,globalContent } from '../lib/cms';
import { Image } from 'emdash/ui';
const { collection, route }=Astro.props;
const [items,page,g]=await Promise.all([entries(collection),entry('pages',route),globalContent()]);
---
<Base title={page.data.title} global={g}><section class="page-intro container"><p class="eyebrow">{page.id}</p><h1>{page.data.title}</h1><p>{page.data.excerpt}</p></section><section class="section container"><div class:list={['editorial-grid',{'two-columns':collection==='branches'}]}>{items.map(item=><article class="editorial-card"><a href={`/${route}/${item.id}`}><Image image={item.data.image}/></a><p class="eyebrow">{item.data.eyebrow}</p><h2><a href={`/${route}/${item.id}`}>{item.data.title}</a></h2><p>{item.data.excerpt}</p><a class="text-link" href={`/${route}/${item.id}`}>{collection==='articles'?g.ui.read_article:collection==='branches'?g.ui.contact_team:item.data.title} ↗</a></article>)}</div></section></Base>
