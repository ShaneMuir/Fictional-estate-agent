---
import { Image } from 'emdash/ui';
import { entries, safeLink } from '../lib/cms';
import PropertyCard from './PropertyCard.astro';
const { blocks = [], global: g } = Astro.props;
const needs = (name: string) => blocks.some((b: any) => b._type === name);
const [properties, areas, agents] = await Promise.all([needs('property_grid') ? entries('properties') : [], needs('area_cards') ? entries('areas') : [], needs('team_grid') ? entries('agents') : []]);
---
{blocks.map((b: any) => (
  b._type === 'hero' ? <section class:list={['hero', { 'hero-home': ['/','/home'].includes(Astro.url.pathname) }]}>
    <div class="hero-image"><Image image={b.image} priority /></div>
    <div class="hero-shade"></div>
    <div class="container hero-copy"><p class="eyebrow">{b.eyebrow}</p><h1>{b.heading}</h1><p class="hero-intro">{b.text}</p>{safeLink(b.link) && <a class="button light" href={safeLink(b.link)}>{b.label}<span aria-hidden="true">↗</span></a>}</div>
    {['/','/home'].includes(Astro.url.pathname) && <form class="quick-search container" action="/sales" method="get"><div class="search-title">{g.ui.search}<span class="search-tabs"><button type="submit" formaction="/sales">{g.ui.sale}</button><button type="submit" formaction="/lettings">{g.ui.let}</button></span></div><label>{g.ui.location}<input name="location" placeholder={g.ui.any_location}/></label><label>{g.ui.max_price}<select name="max"><option value="">{g.ui.any_price}</option>{[300000,500000,750000,1000000].map(v=><option value={v}>£{v.toLocaleString('en-GB')}</option>)}</select></label><button class="button" type="submit">{g.ui.search_button}<span aria-hidden="true">↗</span></button></form>}
  </section> :
  b._type === 'property_grid' ? <section class="section container"><div class="section-heading"><div><p class="eyebrow">{b.eyebrow}</p><h2>{b.heading}</h2><p class="muted">{b.text}</p></div>{safeLink(b.link) && <a class="text-link" href={safeLink(b.link)}>{b.label} <span aria-hidden="true">↗</span></a>}</div><div class="property-grid">{properties.filter(p=>b.market==='all'||p.data.market===b.market).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)).slice(0,b.limit || 3).map(p=><PropertyCard property={p} ui={g.ui}/>)}</div></section> :
  b._type === 'text_image' ? <section class="split-section"><div class="split-image"><Image image={b.image}/></div><div class="split-copy"><p class="eyebrow">{b.eyebrow}</p><h2>{b.heading}</h2><p>{b.text}</p>{safeLink(b.link)&&<a class="text-link" href={safeLink(b.link)}>{b.label} <span aria-hidden="true">↗</span></a>}</div></section> :
  b._type === 'area_cards' ? <section class="section container"><div class="section-heading"><div><p class="eyebrow">{b.eyebrow}</p><h2>{b.heading}</h2><p class="muted">{b.text}</p></div></div><div class="area-grid">{areas.map(a=><a class="area-card" href={`/areas/${a.id}`}><Image image={a.data.image}/><div><h3>{a.data.title}</h3><p>{a.data.excerpt}</p></div><span aria-hidden="true">↗</span></a>)}</div></section> :
  b._type === 'team_grid' ? <section class="section container"><p class="eyebrow">{b.eyebrow}</p><h2>{b.heading}</h2><p>{b.text}</p><div class="team-grid">{agents.map(a=><article class="team-card"><div class="avatar" aria-hidden="true">{a.data.initials}</div><h3>{a.data.title}</h3><p>{a.data.role}</p></article>)}</div></section> :
  b._type === 'testimonials' ? <section class="testimonial section"><div class="container"><p class="eyebrow">{b.eyebrow}</p><h2>{b.heading}</h2>{b.items?.map((i: any)=><figure><blockquote>“{i.quote}”</blockquote><figcaption>{i.name}<span>{i.detail}</span></figcaption></figure>)}</div></section> :
  b._type === 'faqs' ? <section class="section container narrow"><h2>{b.heading}</h2>{b.items?.map((i: any)=><details><summary>{i.question}</summary><p>{i.answer}</p></details>)}</section> :
  b._type === 'cta' ? <section class="cta"><div class="container"><div><p class="eyebrow">{b.eyebrow}</p><h2>{b.heading || g.shared_cta_heading}</h2><p>{b.text || g.shared_cta_text}</p></div><a class="button light" href={safeLink(b.link)}>{b.label || g.shared_cta_label}<span aria-hidden="true">↗</span></a></div></section> : null
))}
