{
  "name": "emdash",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Northfield & Co.",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.2",
    "emdash": "^1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@northfield/enquiries": "file:plugins/northfield-enquiries"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10"
  }
}
